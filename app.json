{
  "expo": {
    "name": "Peça Já",
    "slug": "peca-ja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pecaja",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pecaja.cliente",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Peça Já usa sua localização para mostrar comércios próximos e estimar entregas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O Peça Já usa sua localização para melhorar o rastreio da entrega enquanto o app está em uso.",
        "NSCameraUsageDescription": "O Peça Já precisa da câmera para tirar sua foto de perfil.",
        "NSPhotoLibraryUsageDescription": "O Peça Já precisa acessar suas fotos para a foto de perfil.",
        "LSApplicationQueriesSchemes": [
          "waze",
          "comgooglemaps"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.pecaja.cliente",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Peça Já precisa acessar suas fotos para a foto de perfil.",
          "cameraPermission": "O Peça Já precisa da câmera para tirar sua foto de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Peça Já usa sua localização para mostrar comércios próximos e estimar entregas.",
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00A86B",
          "defaultChannel": "orders",
          "sounds": []
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "",
      "router": {},
      "eas": {
        "projectId": "6eb68816-a0c6-4842-ad75-40fc09735e6c"
      }
    },
    "owner": "peca-ja"
  }
}
