# Variáveis Railway — Peça Já (copiar no painel Variables)
# Nunca commite valores reais.

NODE_ENV=production
PORT=8787
MP_PAYOUT_MODE=live

# Mesma connection string Supabase (pooler :6543 + pgbouncer=true)
DATABASE_URL=
FLEET_DATABASE_URL=

# Access Token LIVE (APP_USR-...) — conta PJ Peça Já quando abrir CNPJ
MP_ACCESS_TOKEN=

# --- Marketplace split (OFF no piloto; ligar depois da PJ + OAuth lojas) ---
# MP_MARKETPLACE_SPLIT=0
# PLATFORM_MP_COLLECTOR_ID=   # user/collector id da conta PJ no MP
# MP_SPLIT_HOLD_DRIVER_ON_PLATFORM=1  # frete na application_fee; motoboy via ledger

# PIN interno suporte (não use EXPO_PUBLIC_)
SUPPORT_PIN=

# E-mails CEO do painel /admin (vírgula). Após mudar: restart/redeploy do serviço api.
PLATFORM_CEO_EMAILS=

# Piloto: código de reset de senha no JSON da API (não use 0 até ter e-mail)
EXPOSE_PASSWORD_RESET_CODE=1
