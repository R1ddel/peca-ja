# =============================================================================
# Mercado Pago — OBRIGATÓRIO para Pix e Cartão com confirmação automática
# https://www.mercadopago.com.br/developers/panel/app
# =============================================================================
# Produção: use APP_USR-... (LIVE). Nunca commite o token.
# Sandbox: TEST-... só em desenvolvimento.

MP_ACCESS_TOKEN=

# Saque Pix-out (carteira do comerciante/entregador → chave Pix)
# live = Mercado Pago Payouts (produto liberado na conta)
# simulate = PROIBIDO em NODE_ENV=production
MP_PAYOUT_MODE=live
# MP_PAYOUT_PATH=/v1/transaction_intents

# Marketplace split 1:1 (OFF = piloto atual: tudo na conta da plataforma + ledger)
# Ligue só com conta PJ + OAuth das lojas. Ver docs/SPLIT_MARKETPLACE.md
# MP_MARKETPLACE_SPLIT=0
# PLATFORM_MP_COLLECTOR_ID=
# MP_SPLIT_HOLD_DRIVER_ON_PLATFORM=1

# =============================================================================
# PRODUÇÃO (Neon + Railway) — ver docs/DEPLOY.md e docs/SMOKE_PILOT.md
# =============================================================================
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
# FLEET_DATABASE_URL=
# PLATFORM_DATABASE_URL=

# Obrigatório no app release / EAS (mesmo host serve frota + plataforma + pagamentos):
# EXPO_PUBLIC_API_URL=https://sua-api.up.railway.app
# Também substitua REPLACE_WITH_RAILWAY_URL em eas.json e app.json extra.apiUrl

# Piloto LAN (Expo Go):
EXPO_PUBLIC_USE_FLEET_SERVER=1
# EXPO_PUBLIC_FLEET_URL=http://192.168.0.10:8787
# EXPO_PUBLIC_FLEET_PORT=8787

# Segredo opcional para sync da frota (além da sessão do usuário)
# FLEET_SYNC_SECRET=

# Segredo opcional para crédito/estorno de ledger via ops (mesmo valor que FLEET_SYNC_SECRET serve)
# PLATFORM_LEDGER_SECRET=

# PIN do painel suporte — SÓ no servidor (nunca EXPO_PUBLIC_ em produção)
# SUPPORT_PIN=

# E-mails que viram CEO no /admin (separados por vírgula)
# PLATFORM_CEO_EMAILS=voce@empresa.com

# Piloto: devolve código de recuperação no JSON (0 = desliga quando tiver SMTP)
# EXPOSE_PASSWORD_RESET_CODE=1

# Porta do servidor standalone
# PORT=8787

# === FLAGS — todas OFF em produção ===
# EXPO_PUBLIC_ALLOW_MANUAL_PIX_CONFIRM=0
# EXPO_PUBLIC_USE_MOCK_PAYMENTS=0
# EXPO_PUBLIC_ALLOW_DEMO_CITY=0
# EXPO_PUBLIC_ALLOW_TEST_PIX=0
# EXPO_PUBLIC_SUPPORT_PIN=   # NÃO use — vaza no bundle
